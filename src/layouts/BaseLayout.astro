---
import PageShell from "../components/PageShell.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const DEFAULT_TITLE = "Mateusz Ozimkiewicz — Full-Stack Developer";
const DEFAULT_DESCRIPTION =
  "Portfolio Mateusza Ozimkiewicza — React, TypeScript, FastAPI and safety-first AI applications.";

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, ogImage } =
  Astro.props;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06080f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Runs before first paint. Marks JS availability (entrance animation is
         additive) and arms the KOYE threshold ONLY when arriving at the Yuzuki
         route from the homepage entry, first time this session, motion allowed. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          // MELLY999 intro: homepage only, once per browser session, never under
          // reduced motion. sessionStorage only — no cookies, no tracking. If this
          // script never runs, the class is never added and the page is unaffected.
          if (location.pathname.replace(/\/+$/, "") === "") {
            var introSeen = sessionStorage.getItem("melly999_intro_seen");
            var introReduce = window.matchMedia(
              "(prefers-reduced-motion: reduce)",
            ).matches;
            if (!introSeen) {
              sessionStorage.setItem("melly999_intro_seen", "1");
              if (!introReduce) d.classList.add("intro-on");
            }
          }
        } catch (e) {}
        try {
          var onYuzuki =
            location.pathname.replace(/\/+$/, "") === "/projects/yuzuki";
          var state = sessionStorage.getItem("koye");
          var reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (onYuzuki && state === "pending") {
            if (reduce) sessionStorage.setItem("koye", "seen");
            else d.classList.add("koye-on");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <PageShell>
      <slot />
    </PageShell>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
