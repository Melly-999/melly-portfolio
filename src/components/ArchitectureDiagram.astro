---
/**
 * Yuzuki ↔ Hermes architecture (handoff §8). An ORIGINAL diagram derived from the
 * public source description — labelled as such, never presented as a capture.
 * The authority boundary is the point: Hermes owns sessions, memory and routing
 * authority; Yuzuki owns presentation and lifecycle.
 *
 * Forbidden here: any cloud node, a "future provider" branch, provider logos, or
 * arrows implying bidirectional authority. There is no cloud path in this diagram.
 *
 * Two SVGs are authored (desktop / redrawn mobile) — not one scaled. Both are
 * token-driven, real <text>, and paired with a DOM-present semantic <ol>.
 */
const tiers = [
  { title: "Yuzuki UI", sub: "React / TypeScript · Tauri shell", owns: "window, child process tree" },
  { title: "Local Node API", sub: "127.0.0.1:8787", owns: "status, session + search brokering" },
  { title: "Hermes Agent", sub: "Python runtime", owns: "sessions · memory · routing authority" },
  { title: "Local model provider", sub: "e.g. Ollama", owns: null },
] as const;

const desc =
  "Four tiers, top to bottom. Yuzuki UI, a React and TypeScript Tauri shell, owns the window and child process tree. It calls the Local Node API at 127.0.0.1 port 8787, which owns status and session and search brokering. Across a dotted authority boundary, over a loopback WebSocket carrying JSON-RPC, sits the Hermes Agent Python runtime, which owns sessions, memory and routing authority. Hermes calls a local model provider such as Ollama. The whole stack is enclosed in one loop labelled on this machine, no cloud path active.";
---

<figure class="arch" data-draw>
  <!-- Desktop / tablet -->
  <svg class="arch__svg arch__svg--wide" viewBox="0 0 880 620" role="img" aria-labelledby="arch-w-t arch-w-d" preserveAspectRatio="xMidYMid meet">
    <title id="arch-w-t">Yuzuki and Hermes architecture — derived diagram</title>
    <desc id="arch-w-d">{desc}</desc>

    <rect class="arch__loop draw" pathLength="1" x="40" y="8" width="800" height="604" rx="20" style="--i:0;--draw-ms:900ms"></rect>

    <g class="arch__tiers">
      {[24, 168, 336, 480].map((y, i) => (
        <g class="fade" style={`--fade-delay:${180 + i * 60}ms`}>
          <rect class="arch__box" x="160" y={y} width="560" height="104" rx="8"></rect>
          <text class="arch__title" x="184" y={y + 34}>{tiers[i].title}</text>
          <text class="arch__sub" x="184" y={y + 58}>{tiers[i].sub}</text>
          {tiers[i].owns && <text class="arch__owns" x="184" y={y + 82}>owns: {tiers[i].owns}</text>}
        </g>
      ))}
    </g>

    <line class="arch__link draw" pathLength="1" x1="440" y1="128" x2="440" y2="168" style="--i:150;--draw-ms:400ms"></line>
    <line class="arch__link draw" pathLength="1" x1="440" y1="272" x2="440" y2="336" style="--i:350;--draw-ms:500ms"></line>
    <line class="arch__link draw" pathLength="1" x1="440" y1="440" x2="440" y2="480" style="--i:550;--draw-ms:400ms"></line>
    <text class="arch__transport fade" x="452" y="152" style="--fade-delay:300ms">in-process</text>
    <text class="arch__transport fade" x="452" y="326" style="--fade-delay:500ms">loopback WebSocket · JSON-RPC</text>
    <text class="arch__transport fade" x="452" y="464" style="--fade-delay:700ms">local provider call</text>

    <g class="fade" style="--fade-delay:850ms">
      <line class="arch__boundary" x1="60" y1="300" x2="820" y2="300"></line>
      <text class="arch__boundary-label" x="64" y="291">AUTHORITY BOUNDARY</text>
    </g>

    <rect class="arch__chip-bg" x="252" y="601" width="376" height="22"></rect>
    <text class="arch__chip" x="440" y="616" text-anchor="middle">ON THIS MACHINE · NO CLOUD PATH ACTIVE</text>
  </svg>

  <!-- Phones: redrawn, not scaled -->
  <svg class="arch__svg arch__svg--narrow" viewBox="0 0 360 720" role="img" aria-labelledby="arch-n-t arch-n-d" preserveAspectRatio="xMidYMid meet">
    <title id="arch-n-t">Yuzuki and Hermes architecture — derived diagram</title>
    <desc id="arch-n-d">{desc}</desc>

    <rect class="arch__loop draw" pathLength="1" x="3" y="3" width="354" height="692" rx="16" style="--i:0;--draw-ms:900ms"></rect>

    {[16, 176, 376, 536].map((y, i) => (
      <g class="fade" style={`--fade-delay:${180 + i * 60}ms`}>
        <rect class="arch__box" x="12" y={y} width="336" height="120" rx="8"></rect>
        <text class="arch__title" x="28" y={y + 36}>{tiers[i].title}</text>
        <text class="arch__sub" x="28" y={y + 62}>{tiers[i].sub}</text>
        {tiers[i].owns && (
          <>
            <text class="arch__owns" x="28" y={y + 88}>owns:</text>
            <text class="arch__owns" x="28" y={y + 106}>{tiers[i].owns}</text>
          </>
        )}
      </g>
    ))}

    <line class="arch__link draw" pathLength="1" x1="180" y1="136" x2="180" y2="176" style="--i:150;--draw-ms:400ms"></line>
    <line class="arch__link draw" pathLength="1" x1="180" y1="296" x2="180" y2="376" style="--i:350;--draw-ms:500ms"></line>
    <line class="arch__link draw" pathLength="1" x1="180" y1="496" x2="180" y2="536" style="--i:550;--draw-ms:400ms"></line>
    <text class="arch__transport fade" x="192" y="160" style="--fade-delay:300ms">in-process</text>
    <text class="arch__transport fade" x="192" y="350" style="--fade-delay:500ms">loopback WebSocket</text>
    <text class="arch__transport fade" x="192" y="366" style="--fade-delay:500ms">JSON-RPC</text>
    <text class="arch__transport fade" x="192" y="520" style="--fade-delay:700ms">local provider call</text>

    <g class="fade" style="--fade-delay:850ms">
      <line class="arch__boundary" x1="12" y1="336" x2="348" y2="336"></line>
      <text class="arch__boundary-label" x="16" y="327">AUTHORITY BOUNDARY</text>
    </g>

    <rect class="arch__chip-bg" x="18" y="684" width="324" height="22"></rect>
    <text class="arch__chip" x="180" y="699" text-anchor="middle">ON THIS MACHINE · NO CLOUD PATH ACTIVE</text>
  </svg>

  <!-- Semantic fallback: DOM-present, visually hidden. The architecture without the graphic. -->
  <ol class="sr-only">
    {tiers.map((t) => (
      <li>{t.title} — {t.sub}{t.owns ? `. Owns: ${t.owns}.` : "."}</li>
    ))}
  </ol>
  <p class="sr-only">
    The authority boundary sits between the Local Node API and the Hermes Agent.
    Hermes holds sessions, memory and routing authority. Yuzuki holds presentation
    and lifecycle only, and does not mirror the canonical session database. The
    whole stack runs on this machine; no cloud path is active.
  </p>

  <figcaption class="arch__caption">
    Derived diagram — drawn from the public source description. Not a product screenshot.
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
    max-width: 880px;
    margin-inline: auto;
  }

  .arch__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .arch__svg--narrow {
    display: none;
    max-width: 460px;
    margin-inline: auto;
  }

  @media (max-width: 899px) {
    .arch__svg--wide {
      display: none;
    }
    .arch__svg--narrow {
      display: block;
    }
  }

  .arch__loop {
    fill: none;
    stroke: var(--color-violet);
    stroke-width: 1;
    stroke-opacity: 0.45;
  }

  .arch__box {
    fill: var(--color-panel);
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .arch__link {
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .arch__title {
    fill: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .arch__sub {
    fill: var(--color-ink-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .arch__owns,
  .arch__transport {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .arch__boundary {
    stroke: var(--color-violet);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .arch__boundary-label,
  .arch__chip {
    fill: var(--color-violet);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  /* The label chip sits on canvas so the loop rule breaks cleanly behind it. */
  .arch__chip-bg {
    fill: var(--color-canvas);
  }

  .arch__caption {
    margin-top: var(--space-16);
    color: var(--color-ink-muted);
    font-size: var(--text-label);
    text-align: center;
  }
</style>
