---
import StatusChip from "./StatusChip.astro";
import { social } from "../data/social";

/**
 * Systems / Labs Explorer (handoff §14) — where Max Leiter's personality appears,
 * once, in a bounded area. A directory metaphor: `~/melly`, `projects/`, `labs/`,
 * `about.md`, `links/`. It is a personality layer, not navigation: nothing here is
 * the only way to reach anything, and it does not duplicate the main nav.
 *
 * No fake OS, no window chrome, no fake shell prompt, no simulated input, no
 * blinking cursor, no typewriter effect. Real nested <ul>/<a>; the tree glyphs
 * are CSS ::before content, so a screen reader hears a nested list, not
 * punctuation. Pending links (X) render greyed with `(pending)` in text.
 */
const projects = [
  { name: "yuzuki", desc: "local-first AI desktop", href: "/projects/yuzuki", chip: { variant: "verified", label: "LIVE-VERIFIED (private)" } },
  { name: "mellycore", desc: "agent orchestration", href: "/projects/aios", chip: { variant: "partial", label: "PARTIAL" } },
  { name: "automation", desc: "operational workflows", href: "#automation", chip: { variant: "concept", label: "CONCEPT" } },
] as const;
---

<div class="tree" role="group" aria-label="Systems index">
  <p class="tree__root mono">~/melly</p>
  <ul class="tree__list">
    <li class="tree__dir">
      <span class="tree__name mono">projects/</span>
      <ul class="tree__list">
        {
          projects.map((p) => (
            <li class="tree__row">
              <a class="tree__link" href={p.href}>
                <span class="tree__name mono">{p.name}</span>
                <span class="tree__desc">{p.desc}</span>
                <StatusChip variant={p.chip.variant} label={p.chip.label} bare />
              </a>
            </li>
          ))
        }
      </ul>
    </li>
    <li class="tree__dir">
      <span class="tree__name mono">labs/</span>
      <ul class="tree__list">
        <li class="tree__row">
          <span class="tree__link tree__link--static">
            <span class="tree__name mono">experiments</span>
            <span class="tree__desc">interface + interaction work — a separate prototype, not part of Yuzuki</span>
            <StatusChip variant="prototype" label="PROTOTYPE" bare />
          </span>
        </li>
      </ul>
    </li>
    <li class="tree__row">
      <a class="tree__link" href="/about">
        <span class="tree__name mono">about.md</span>
      </a>
    </li>
    <li class="tree__dir">
      <span class="tree__name mono">links/</span>
      <ul class="tree__list">
        {
          social.map((s) => (
            <li class="tree__row">
              {s.enabled && s.href ? (
                <a class="tree__link" href={s.href} target="_blank" rel="noopener noreferrer">
                  <span class="tree__name mono">{s.id === "x" ? "x" : s.short.toLowerCase()}</span>
                  <span class="tree__desc" aria-hidden="true">↗</span>
                  <span class="sr-only">{s.label} (opens in a new tab)</span>
                </a>
              ) : (
                <span class="tree__link tree__link--static tree__link--pending">
                  <span class="tree__name mono">{s.id}</span>
                  <span class="tree__desc">(pending)</span>
                  <span class="sr-only">{s.label} — link pending</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </li>
  </ul>
</div>

<style>
  .tree {
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .tree__root {
    margin-bottom: var(--space-8);
    color: var(--color-ink-muted);
  }

  .tree__list {
    position: relative;
    margin: 0;
    padding-left: var(--space-24);
  }

  /* Vertical trunk + branch glyphs live in CSS so AT hears a nested list. */
  .tree__list::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 14px;
    width: 1px;
    background: var(--color-line);
  }

  .tree__row,
  .tree__dir {
    position: relative;
  }

  .tree__row::before,
  .tree__dir::before {
    content: "";
    position: absolute;
    left: calc(var(--space-24) * -1 + 6px);
    top: 22px;
    width: 14px;
    height: 1px;
    background: var(--color-line);
  }

  .tree__dir > .tree__name {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-secondary);
  }

  .tree__link {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-16);
    min-height: 44px;
    padding-left: var(--space-16);
    color: var(--color-ink);
  }

  /* Hover: name goes violet and a → appears in the left gutter. No fill, no lift. */
  .tree__link::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-violet);
    opacity: 0;
  }

  a.tree__link:hover,
  a.tree__link:focus-visible {
    color: var(--color-ink);
  }

  a.tree__link:hover .tree__name,
  a.tree__link:focus-visible .tree__name {
    color: var(--color-violet);
  }

  a.tree__link:hover::before,
  a.tree__link:focus-visible::before {
    opacity: 1;
  }

  .tree__desc {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }

  .tree__link--pending,
  .tree__link--pending .tree__name {
    color: var(--color-ink-muted);
  }

  @media (max-width: 599px) {
    /* Description moves to its own line under the name, indented to the glyph. */
    .tree__link {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
      padding-block: var(--space-4);
    }
  }
</style>
