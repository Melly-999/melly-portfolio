---
/**
 * Suggested starting points for Yuzuki — a compact, quiet set, in the concise
 * pattern common to modern AI products (not a copy of any one). PORTFOLIO-ONLY:
 * choosing one fills the example field below. Nothing is sent, no provider or
 * Yuzuki runtime is called, and no session is created. The labelling says so.
 */
const prompts = [
  "Explain this architecture",
  "Compare two implementation approaches",
  "Plan my next development task",
  "Help me debug this error",
  "Summarize these notes",
  "Turn this idea into a step-by-step plan",
] as const;
---

<section class="ps" aria-labelledby="ps-h" data-prompt-demo>
  <div class="ps__head">
    <h3 id="ps-h" class="ps__title">Starting points</h3>
    <span class="chip chip--prototype">
      <svg class="chip__glyph" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
        <circle cx="5" cy="5" r="3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 1.6" />
      </svg>
      <span class="chip__text">EXAMPLE INTERACTION</span>
    </span>
  </div>

  <ul class="ps__list">
    {
      prompts.map((p) => (
        <li>
          <button type="button" class="ps__btn" data-prompt={p} aria-pressed="false">
            {p}
          </button>
        </li>
      ))
    }
  </ul>

  <div class="ps__composer">
    <label class="ps__label" for="ps-field">Example prompt — not sent</label>
    <textarea
      id="ps-field"
      class="ps__field"
      rows="2"
      readonly
      placeholder="Choose a starting point above"
      data-prompt-field></textarea>
    <p class="ps__note">
      Portfolio-only demo. Nothing is sent, no model or provider is contacted, and no
      session is created.
    </p>
    <p class="sr-only" role="status" data-prompt-status></p>
  </div>
</section>

<style>
  .ps {
    display: grid;
    gap: var(--space-16);
    max-width: 720px;
  }

  .ps__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-16);
  }

  .ps__title {
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .ps__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .ps__btn {
    min-height: 44px;
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-ink-secondary);
    font-size: var(--text-label);
    cursor: pointer;
    text-align: left;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .ps__btn:hover,
  .ps__btn[aria-pressed="true"] {
    border-color: var(--color-violet);
    color: var(--color-ink);
  }

  .ps__composer {
    display: grid;
    gap: var(--space-8);
  }

  .ps__label {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ps__field {
    width: 100%;
    resize: none;
    padding: var(--space-12) var(--space-16);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    color: var(--color-ink);
    font: inherit;
  }

  .ps__field::placeholder {
    color: var(--color-ink-muted);
  }

  .ps__note {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-prompt-demo]").forEach((root) => {
    const field = root.querySelector<HTMLTextAreaElement>("[data-prompt-field]");
    const status = root.querySelector<HTMLElement>("[data-prompt-status]");
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-prompt]");
    if (!field) return;
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        field.value = btn.dataset.prompt ?? "";
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        if (status) status.textContent = `Example prompt set: ${field.value}. Not sent.`;
      });
    });
  });
</script>
