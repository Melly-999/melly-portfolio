---
/**
 * MELLY999 brand-entry intro. Homepage only, once per browser session.
 *
 * First frame: full obsidian, the wordmark, nothing else — no spinner, tagline,
 * social links, terminal text, ENTER button or HUD. ~1200ms in total:
 *   0–150ms   black field
 *   150–550   wordmark resolves (opacity + a 3px blur that clears)
 *   550–800   hold
 *   800–1200  dissolves into the hero
 *
 * Progressive enhancement: the real homepage is in the DOM underneath. This layer
 * is display:none unless the inline <head> script arms it (`html.intro-on`), and
 * its exit is a pure CSS animation, so even if JS dies mid-way the layer removes
 * itself and never gates the page. It is aria-hidden, non-interactive and cannot
 * trap focus. Reduced motion: a ~200ms opacity-only version (no blur, no motion).
 *
 * Session lifecycle: the <head> script arms the layer; the script below writes the
 * session key only after the intro has actually played (animationend, or a
 * fallback timer) while the tab is visible. Writing it at arm time let anything
 * that reloads the page early — the Vite dev server does, ~200ms into the very
 * first load — use the session up before a frame of it was seen. A tab opened in
 * the background holds the timeline until it becomes visible.
 */
---

<div class="intro" aria-hidden="true">
  <p class="intro__word">MELLY999</p>
</div>

<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains("intro-on")) return;
    var el = document.querySelector(".intro");
    var marked = false;
    var timer;

    function mark() {
      if (marked || document.visibilityState !== "visible") return;
      marked = true;
      try {
        sessionStorage.setItem("melly999_intro_seen", "1");
      } catch (e) {}
    }

    // Restart the CSS timeline (class off/on) and schedule the "seen" mark.
    function run() {
      d.classList.remove("intro-on");
      void d.offsetWidth;
      d.classList.add("intro-on");
      clearTimeout(timer);
      timer = setTimeout(mark, 1600);
    }

    if (el) {
      el.addEventListener("animationend", function (e) {
        if (e.animationName === "intro-out") mark();
      });
    }
    // Leaving after the wordmark has shown counts as seen; an early reload does not.
    window.addEventListener("pagehide", function () {
      if (performance.now() > 500) mark();
    });

    if (document.visibilityState === "visible") {
      timer = setTimeout(mark, 1600);
    } else {
      document.addEventListener("visibilitychange", function wait() {
        if (document.visibilityState !== "visible") return;
        document.removeEventListener("visibilitychange", wait);
        run();
      });
    }
  })();
</script>

<style is:global>
  .intro {
    display: none;
  }

  html.intro-on .intro {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: var(--color-canvas);
    pointer-events: none;
    animation: intro-out 400ms var(--ease-standard) 800ms forwards;
  }

  .intro__word {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 3rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    padding-left: 0.22em; /* optically re-centres the tracked wordmark */
    color: var(--color-ink);
    animation: intro-word 400ms var(--ease-out-expo) 150ms both;
  }

  @keyframes intro-word {
    from {
      opacity: 0;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Reduced motion: the identity moment stays, as opacity only (~200ms total). */
  @keyframes intro-word-flat {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.intro-on .intro {
      animation: intro-out 80ms linear 120ms forwards;
    }

    .intro__word {
      animation: intro-word-flat 80ms linear 0s both;
    }
  }
</style>
