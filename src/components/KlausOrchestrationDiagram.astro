---
/**
 * Klaus orchestration — a CONCEPT diagram of an owner-defined architecture.
 * HTML/CSS with real list markup (no canvas, no fake terminal). Lane labels are
 * generic roles: no provider, model or integration is named or implied.
 *
 *   USER INTENT → KLAUS → [ARCHITECT | IMPLEMENT | REVIEW] → VERIFIED OUTPUT
 */
const lanes = [
  { role: "Architect", note: "agent / model" },
  { role: "Implement", note: "coding lane" },
  { role: "Review", note: "validator" },
] as const;
---

<figure class="kd" data-flow>
  <ol class="kd__flow" aria-label="Klaus orchestration concept">
    <li class="kd__node">
      <span class="kd__k">Input</span>
      <span class="kd__v">User intent</span>
    </li>
    <li class="kd__node kd__node--core">
      <span class="kd__k">Orchestrator</span>
      <span class="kd__v">Klaus</span>
      <ul class="kd__lanes" aria-label="Work lanes">
        {
          lanes.map((l) => (
            <li class="kd__lane">
              <span class="kd__lane-role">{l.role}</span>
              <span class="kd__lane-note">{l.note}</span>
            </li>
          ))
        }
      </ul>
    </li>
    <li class="kd__node kd__node--out">
      <span class="kd__k">Target state</span>
      <span class="kd__v">Verified output</span>
    </li>
  </ol>
  <figcaption class="kd__cap">
    Concept diagram of an owner-defined architecture — no live providers, models or
    integrations are shown or claimed.
  </figcaption>
</figure>

<style>
  .kd {
    margin: 0;
    max-width: 760px;
  }

  .kd__flow {
    display: grid;
    gap: var(--space-24);
  }

  .kd__node {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  /* Connector between stages: a plain 1px line, no arrow-glow. */
  .kd__node + .kd__node::before {
    content: "";
    position: absolute;
    left: 50%;
    top: calc(var(--space-24) * -1);
    height: var(--space-24);
    width: 1px;
    background: var(--color-line);
  }

  .kd__node--core {
    background: var(--color-panel-raised);
    border-color: var(--color-violet);
  }

  .kd__k {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kd__v {
    color: var(--color-ink);
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .kd__lanes {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-16);
  }

  @media (min-width: 640px) {
    .kd__lanes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .kd__lane {
    display: grid;
    gap: 2px;
    padding: var(--space-12);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
  }

  .kd__lane-role {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kd__lane-note {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }

  .kd__cap {
    margin-top: var(--space-16);
    color: var(--color-ink-muted);
    font-size: var(--text-label);
    max-width: 62ch;
  }
</style>
