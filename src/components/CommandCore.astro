---
// Purely decorative background visual. No readable text, no data, no
// external assets — static SVG only, with one subtle opacity pulse on
// the amber ring (disabled under prefers-reduced-motion).
---

<div class="command-core" aria-hidden="true">
  <svg
    class="command-core__svg"
    viewBox="0 0 480 480"
    width="100%"
    height="100%"
    focusable="false"
  >
    <defs>
      <radialGradient id="cc-core" cx="35%" cy="30%" r="75%">
        <stop offset="0%" stop-color="#3a4358"></stop>
        <stop offset="45%" stop-color="#171e2b"></stop>
        <stop offset="100%" stop-color="#06080d"></stop>
      </radialGradient>
      <filter id="cc-soft-glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="8"></feGaussianBlur>
      </filter>
    </defs>

    <!-- atmospheric haze -->
    <ellipse cx="240" cy="240" rx="230" ry="200" fill="rgba(79,147,230,0.05)"></ellipse>

    <!-- outer cyan context ring -->
    <ellipse cx="240" cy="240" rx="210" ry="86" fill="none" stroke="rgba(79,147,230,0.32)" stroke-width="1.2"></ellipse>
    <circle cx="450" cy="240" r="3.5" fill="#7fd8ea"></circle>
    <circle cx="79" cy="295" r="3" fill="#5fc8de"></circle>
    <circle cx="168" cy="159" r="3" fill="#5fc8de"></circle>

    <!-- middle cyan context ring -->
    <ellipse cx="240" cy="240" rx="150" ry="62" fill="none" stroke="rgba(79,147,230,0.48)" stroke-width="1.4"></ellipse>
    <circle cx="355" cy="280" r="3.5" fill="#8fdeee"></circle>
    <circle cx="99" cy="219" r="3" fill="#5fc8de"></circle>

    <!-- inner amber safety ring: continuous, unbroken -->
    <ellipse
      class="command-core__amber-glow"
      cx="240"
      cy="240"
      rx="100"
      ry="40"
      fill="none"
      stroke="#f7933c"
      stroke-width="2.5"
      filter="url(#cc-soft-glow)"
      opacity="0.85"
    ></ellipse>
    <ellipse cx="240" cy="240" rx="100" ry="40" fill="none" stroke="#ff9d4a" stroke-width="1.6"></ellipse>

    <!-- obsidian core -->
    <circle cx="240" cy="240" r="62" fill="url(#cc-core)"></circle>
    <circle cx="240" cy="240" r="62" fill="none" stroke="rgba(122,152,192,0.15)" stroke-width="1"></circle>
  </svg>
</div>

<style>
  .command-core {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .command-core__svg {
    position: absolute;
    right: -8%;
    top: 50%;
    transform: translateY(-50%);
    width: min(640px, 60vw);
    height: min(640px, 60vw);
    max-width: 640px;
  }

  .command-core__amber-glow {
    animation: cc-breathe 5s ease-in-out infinite;
  }

  @keyframes cc-breathe {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 0.95;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .command-core__amber-glow {
      animation: none;
      opacity: 0.85;
    }
  }

  /* Simplify away entirely on small mobile to avoid clipping/overflow
     and to keep the hero compact — identity and copy take priority. */
  @media (max-width: 767px) {
    .command-core {
      display: none;
    }
  }
</style>
