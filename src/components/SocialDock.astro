---
import { social } from "../data/social";

/**
 * Social identity dock (handoff §5). Reads src/data/social.ts.
 * Active items are semantic <a> opening a new tab. Pending items (X) render at
 * full size and layout weight as a non-link <span> — never a dead <a>.
 */
interface Props {
  /** Always-visible labels (mobile, footer). Desktop hero reveals on hover/focus. */
  showLabels?: boolean;
  class?: string;
}

const { showLabels = false, class: extra } = Astro.props;

// Simple monochrome line marks on a 24px grid — not official brand logos.
const glyphs = {
  github:
    "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
  linkedin:
    "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z",
  x: "M4 4l16 16M20 4 4 20",
} as const;
---

<ul
  class:list={["dock", { "dock--labels": showLabels }, extra]}
  aria-label="Profiles"
>
  {
    social.map((item) => (
      <li class="dock__item">
        {item.enabled && item.href ? (
          <a
            class="dock__hit"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="dock__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={glyphs[item.id]} />
            </svg>
            <svg class="dock__arrow" viewBox="0 0 8 8" aria-hidden="true" focusable="false">
              <path d="M1 7 7 1M2.500 1H7v4.500" />
            </svg>
            <span class="sr-only">
              {item.label} (opens in a new tab)
            </span>
          </a>
        ) : (
          <span class="dock__hit dock__hit--pending" role="img" aria-label={`${item.label} — link pending`}>
            <svg class="dock__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={glyphs[item.id]} />
            </svg>
          </span>
        )}
        <span class="dock__label" aria-hidden="true">
          {item.enabled ? item.short : `${item.short} — pending`}
        </span>
      </li>
    ))
  }
</ul>
