---
/**
 * Reusable horizontal→vertical spine (handoff §26). Real <ol> markup; the rule
 * and discs are CSS, not content. One component, three instances: Yuzuki's
 * local-first spine, OpsPilot's flow (`boxed`), and How I Build.
 *
 * Motion: the rule draws once (transform: scaleX — never width) and discs fade
 * in behind it; under reduced motion it is fully drawn at first paint.
 */
interface Step {
  label: string;
  /** Emphasised node: violet disc + a hidden text marker (never colour alone). */
  key?: boolean;
  sub?: string;
}

interface Props {
  steps: readonly Step[];
  /** `boxed` = OpsPilot's five plain boxes, sans type. Default = rule + discs. */
  variant?: "spine" | "boxed";
  label: string;
  stagger?: number;
}

const { steps, variant = "spine", label, stagger = 120 } = Astro.props;
---

<ol
  class:list={["spine", `spine--${variant}`]}
  aria-label={label}
  style={`--n:${steps.length}`}
>
  {
    steps.map((step, i) => (
      <li
        class:list={["spine__step", { "spine__step--key": step.key }]}
        style={`--i:${i};--stagger:${stagger}ms`}
        data-flow
      >
        <span class="spine__node" aria-hidden="true" />
        <span class="spine__label">
          {step.label}
          {step.key && <span class="sr-only"> — key stage</span>}
        </span>
        {step.sub && <span class="spine__sub">{step.sub}</span>}
      </li>
    ))
  }
</ol>

<style>
  .spine {
    --line: var(--color-line);
    position: relative;
    display: grid;
    gap: var(--space-24);
    grid-template-columns: minmax(0, 1fr);
    padding-left: var(--space-32);
  }

  /* Vertical by default (mobile): rule down the left. */
  .spine::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }

  .spine__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .spine__node {
    position: absolute;
    left: calc(var(--space-32) * -1 + 1px);
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-canvas);
    border: 1px solid var(--color-ink-muted);
  }

  .spine__step--key .spine__node {
    background: var(--color-violet);
    border-color: var(--color-violet);
  }

  .spine__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .spine__sub {
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  @media (min-width: 900px) {
    .spine--spine {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      padding-left: 0;
      padding-top: var(--space-32);
      gap: var(--space-16);
    }

    .spine--spine::before {
      left: 0;
      right: 0;
      top: 5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .spine--spine .spine__node {
      left: 0;
      top: calc(var(--space-32) * -1 + 1px);
    }

    /* Alternate labels above/below would collide at 7 stages; keep them below
       and wrap. Labels are never truncated. */
    .spine--spine .spine__label {
      overflow-wrap: anywhere;
    }
  }

  /* OpsPilot: five plain boxes, one emphasised, sans type, single direction. */
  .spine--boxed {
    padding-left: 0;
  }

  .spine--boxed::before {
    display: none;
  }

  .spine--boxed .spine__step {
    padding: var(--space-16);
    min-height: 56px;
    justify-content: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .spine--boxed .spine__step--key {
    border-color: var(--color-violet);
  }

  .spine--boxed .spine__node {
    display: none;
  }

  .spine--boxed .spine__label {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .spine--boxed {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--space-24);
    }

    .spine--boxed .spine__step:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: calc(var(--space-24) * -0.75);
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-ink-muted);
    }
  }
</style>
