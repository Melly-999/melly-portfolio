---
import StatusChip from "./StatusChip.astro";

/**
 * Validation matrix (handoff §11). Real test counts as engineering evidence — a
 * technical table, NOT four SaaS metric cards. Counts come from the integration
 * pack and are raw test counts only.
 *
 * Hazard: never merge these with any other validation run, and never add a total.
 *
 * A real <table> with caption, scoped headers, tabular figures. Numerators count
 * up once (700ms) on first view; the FINAL value is in the DOM from first render
 * (aria-hidden visual + sr-only value) so assistive tech never hears a partial.
 */
const suites = [
  { name: "Adapter", pass: 23, total: 23 },
  { name: "Server", pass: 210, total: 210 },
  { name: "Frontend", pass: 63, total: 63 },
  { name: "Screenshot boundary", pass: 7, total: 7 },
] as const;
---

<div class="matrix">
  <table class="matrix__table">
    <caption class="matrix__caption">
      Yuzuki public validation — raw test counts. These are raw test counts, not
      uptime, stability, correctness or quality guarantees.
    </caption>
    <thead>
      <tr>
        <th scope="col">Suite</th>
        <th scope="col" class="matrix__num">Result</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        suites.map((s, i) => (
          <tr>
            <th scope="row">{s.name}</th>
            <td class="matrix__num mono">
              <span class="matrix__count" data-count={s.pass} data-delay={i * 90}>
                <span class="sr-only">{s.pass}</span>
                <span data-count-visual aria-hidden="true">{s.pass}</span>
              </span>
              <span aria-hidden="true"> / {s.total}</span>
              <span class="sr-only"> of {s.total}</span>
            </td>
            <td>
              <span class="matrix__ok mono">
                <span class="matrix__dot" aria-hidden="true"></span>PASSED
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr>
        <th scope="row">Public CI</th>
        <td class="matrix__num"></td>
        <td>
          <span class="matrix__ok mono">
            <span class="matrix__dot" aria-hidden="true"></span>GREEN
          </span>
        </td>
      </tr>
    </tfoot>
  </table>

  <p class="matrix__disclaimer">
    These are raw test counts. They are not uptime, stability, correctness or quality guarantees.
  </p>
  <p class="matrix__chip"><StatusChip variant="validated" label="VALIDATED · PUBLIC CI GREEN" /></p>
</div>

<style>
  .matrix {
    max-width: 760px;
    margin-inline: auto;
  }

  .matrix__table {
    width: 100%;
    border-collapse: collapse;
  }

  /* The caption carries the disclaimer so it is announced with the table, but the
     visible copy is the always-visible line beneath. */
  .matrix__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  th,
  td {
    height: 56px;
    padding: 0 var(--space-8);
    text-align: left;
    border-bottom: 1px solid var(--color-line);
    font-weight: 400;
  }

  thead th {
    height: 40px;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  tbody th,
  tfoot th {
    color: var(--color-ink);
    font-size: var(--text-body);
  }

  tfoot th,
  tfoot td {
    border-bottom: 0;
    border-top: 1px solid var(--color-line);
  }

  .matrix__num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-body);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .matrix__ok {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-state-verified);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
  }

  .matrix__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-state-verified);
  }

  .matrix__disclaimer {
    margin-top: var(--space-24);
    color: var(--color-ink-secondary);
    font-size: var(--text-body);
  }

  .matrix__chip {
    margin-top: var(--space-16);
  }

  /* Phones: four stacked blocks — name, then result + status. No side scroll. */
  @media (max-width: 599px) {
    thead {
      display: none;
    }

    .matrix__table,
    tbody,
    tfoot,
    tr {
      display: block;
    }

    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--space-12) 0;
      border-bottom: 1px solid var(--color-line);
    }

    tfoot tr {
      border-bottom: 0;
      border-top: 1px solid var(--color-line);
    }

    tr > th {
      grid-column: 1 / -1;
      height: auto;
      border: 0;
      padding: 0 0 var(--space-4);
    }

    tr > td {
      height: auto;
      border: 0;
      padding: 0;
    }

    .matrix__num {
      text-align: left;
    }
  }
</style>
