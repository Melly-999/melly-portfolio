---
import SocialDock from "./SocialDock.astro";

const email = "mateusz.ozimkiewicz9@gmail.com";
---

<footer class="site-footer">
  <div class="content-width stack" style="gap: var(--space-16);">
    <div>
      <p style="font-weight:700;">Mateusz Ozimkiewicz</p>
      <p class="site-footer__note">Full-Stack Developer · Poland / Remote</p>
    </div>

    <SocialDock showLabels />

    <nav class="site-footer__links" aria-label="Footer">
      <a href={`mailto:${email}`} class="site-footer__email">{email}</a>
    </nav>

    <p class="site-footer__note">Static portfolio built with Astro and TypeScript.</p>
  </div>
</footer>
