---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "mateusz.ozimkiewicz9@gmail.com";
const workflowHref = `mailto:${email}?subject=${encodeURIComponent("Workflow discussion")}`;
const cvRequestHref =
  `mailto:${email}?subject=CV%20request%20%E2%80%94%20Mateusz%20Ozimkiewicz`;
---

<BaseLayout
  title="Contact — Mateusz Ozimkiewicz"
  description="Discuss an AI automation or full-stack project with Mateusz Ozimkiewicz — by email or on GitHub."
>
  <section class="section content-width">
    <h1 style="font-size:var(--text-h1);">Contact</h1>
    <p class="reading-width" style="margin-top:var(--space-16);color:var(--color-text-secondary);">
      Have a workflow that still depends on repetitive manual work? I build AI
      automation, internal tools and full-stack AI applications for businesses.
      Send a short description of the process — what happens today and what should
      happen instead — and I will reply by email.
    </p>
    <p class="reading-width" style="margin-top:var(--space-12);color:var(--color-text-secondary);">
      I'm also open to full-stack roles (remote or Poland-based), and to B2B,
      freelance and contract work.
    </p>
    <div class="cluster" style="margin-top:var(--space-24);">
      <a href={workflowHref} class="button button--primary button--lead">Discuss your workflow</a>
      <a href={`mailto:${email}`} class="button button--secondary" style="overflow-wrap:anywhere;">
        {email}
      </a>
      <a
        href="https://github.com/Melly-999"
        class="button button--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
    <div style="margin-top:var(--space-24);">
      <p style="color:var(--color-text-secondary);">Full CV available by email.</p>
      <a
        href={cvRequestHref}
        class="button button--text"
        style="margin-top:var(--space-8);"
        aria-label="Request Mateusz Ozimkiewicz's full CV by email"
      >
        Request full CV
      </a>
    </div>
  </section>
</BaseLayout>
