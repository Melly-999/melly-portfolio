---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCaseStudyShell from "../../components/ProjectCaseStudyShell.astro";
import Chapter from "../../components/Chapter.astro";
import StatusChip from "../../components/StatusChip.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import ProcessSpine from "../../components/ProcessSpine.astro";

/**
 * /projects/rag-assistant — RAG Document Assistant.
 * The screenshot is a concept interface render used as a portfolio/case-study
 * visual (assets pack ASSET_MANIFEST.md). Figures inside it (document counts,
 * chunks, storage, indexing, relevance scores) are illustrative sample values and
 * are NOT quoted or marketed anywhere in the copy. No implementation technology
 * is claimed beyond the generic pipeline stages.
 */
const pipeline = [
  { label: "Ingestion", sub: "Upload documents" },
  { label: "Chunking", sub: "Split with metadata" },
  { label: "Embedding", sub: "Generate embeddings" },
  { label: "Storage / indexing", sub: "Semantic index" },
  { label: "Retrieval", sub: "Search and rerank" },
  { label: "Answer with sources", key: true, sub: "Cited answer" },
] as const;

const alt =
  "RAG Document Assistant interface showing document search, a source-grounded answer with citations, document collections, and a retrieval pipeline from ingestion through answer generation.";
---

<BaseLayout
  title="RAG Document Assistant — source-grounded document search"
  description="RAG Document Assistant: RAG-powered document search with source-grounded answers — a concept interface for retrieval, citations and document intelligence."
>
  <ProjectCaseStudyShell current="rag-assistant" bare>
    <section class="phero ground-surface" aria-labelledby="rag-title">
      <div class="content-width stack">
        <p class="chip-row">
          <StatusChip variant="concept" label="CONCEPT INTERFACE" />
          <span class="badge">RAG system</span>
        </p>
        <h1 id="rag-title" class="phero__title">RAG Document Assistant</h1>
        <p class="phero__tag">RAG-powered document search with source-grounded answers.</p>
      </div>
      <div class="cinematic-width" style="margin-top:var(--space-32);">
        <ScreenshotFrame
          src="/assets/rag-assistant/rag-document-assistant-concept-1672x941.webp"
          alt={alt}
          caption="RAG Document Assistant — concept interface render. Counts, storage, indexing and relevance figures shown are illustrative sample values, not production statistics."
          srcWidth={1672}
          srcHeight={941}
          scrollable
          scrollWidth={940}
          eager
        />
        <p class="pan-hint">Swipe or use arrow keys to inspect the full interface.</p>
      </div>
    </section>

    <Chapter id="premise" title="01 · Product premise" ground="canvas">
      <p class="pchapter__body">
        Ask a question in plain language and get an answer written from your own
        documents — with the sources shown next to it, so the answer can be checked
        rather than trusted.
      </p>
      <p class="pchapter__body">
        The class of business problem it addresses: internal knowledge search, questions
        about procedures, offers or policies, and support documentation — anywhere staff
        or customers need a checkable answer from a company's own documents. These are
        the kinds of application this pattern fits, not deployments claimed here.
      </p>
    </Chapter>

    <Chapter id="ingestion" title="02 · Document ingestion" ground="surface">
      <p class="pchapter__body">
        Documents of common types are added to named collections. Each is prepared for
        search on the way in, and the interface keeps the document list one glance away.
      </p>
    </Chapter>

    <Chapter id="chunking" title="03 · Chunking + embeddings" ground="canvas">
      <p class="pchapter__body">
        Long documents are split into passages that keep their metadata, then turned
        into embeddings so meaning — not just keywords — can be searched.
      </p>
    </Chapter>

    <Chapter id="storage" title="04 · Storage / indexing" ground="surface">
      <p class="pchapter__body">
        Embeddings are stored in a semantic index alongside the source reference of
        each passage, which is what lets an answer point back to where it came from.
      </p>
    </Chapter>

    <Chapter id="retrieval" title="05 · Retrieval" ground="canvas">
      <p class="pchapter__body">
        A question is matched against the index, and the most relevant passages are
        retrieved and reranked before any answer is written.
      </p>
    </Chapter>

    <Chapter id="answer" title="06 · Answer with sources" ground="surface">
      <p class="pchapter__body">
        The answer is composed from the retrieved passages only, with numbered
        citations inline. The point of the design is that an answer is never shown
        without the material it was built from.
      </p>
    </Chapter>

    <Chapter id="citations" title="07 · Source inspection / citations" ground="canvas">
      <p class="pchapter__body">
        Every citation resolves to a source entry: the document, the page, and a
        relevance indicator. A reader can check the claim against the source in one
        step.
      </p>
    </Chapter>

    <Chapter id="pipeline" title="08 · Architecture pipeline" ground="surface">
      <p class="pchapter__body">
        Six stages, one direction — the same pipeline the interface concept presents.
        The highlighted stage is the one the reader actually sees.
      </p>
      <ProcessSpine label="RAG pipeline" steps={pipeline} />
    </Chapter>

    <Chapter id="status" title="09 · Current status" ground="canvas">
      <p><StatusChip variant="concept" label="CONCEPT INTERFACE · NOT A DEPLOYMENT" /></p>
      <p class="pchapter__body">
        Presented as a portfolio case-study visual. It is not a claim of a live client
        deployment, production scale, or measured retrieval quality, and no specific
        embedding or storage technology is claimed.
      </p>
    </Chapter>
  </ProjectCaseStudyShell>
</BaseLayout>
