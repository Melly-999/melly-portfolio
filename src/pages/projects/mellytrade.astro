---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCaseStudyShell from "../../components/ProjectCaseStudyShell.astro";
import Chapter from "../../components/Chapter.astro";
import StatusChip from "../../components/StatusChip.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import ProcessSpine from "../../components/ProcessSpine.astro";

/**
 * /projects/mellytrade — a trading analytics and monitoring interface study.
 * The screenshot is a concept interface render (assets pack ASSET_MANIFEST.md:
 * "not a claim of an active production trading system"). Every number in it is a
 * sample value. Nothing here claims trades, PnL, broker execution, users, or live
 * market connectivity, and no sample figure is quoted in the copy.
 */
const workflow = [
  { label: "Data ingestion" },
  { label: "Data validation" },
  { label: "Analytics engine" },
  { label: "Monitoring & alerts", key: true },
] as const;

/**
 * Controlled crops of the same concept render (source 1672×941). The lower-right
 * system-health tiles carry visibly malformed generated text, so they are kept out
 * of frame: the overview crop stops above them, and the workflow crop is the
 * clean lower-left panel. No pixels are edited or painted over.
 */
const overviewCrop = { x: 0, y: 0, w: 1672, h: 442 };
const workflowCrop = { x: 226, y: 660, w: 900, h: 240 };

const alt =
  "MellyTrade concept dashboard overview: summary metrics for trades, volume, signals, win rate, latency and risk exposure; a market overview price chart; a live signals list with direction, strength and confidence; and a ranked list of recent alerts.";

const workflowAlt =
  "MellyTrade concept data and analytics workflow in four stages: data ingestion, data validation, analytics engine, and monitoring and alerts.";
---

<BaseLayout
  title="MellyTrade — trading analytics and monitoring cockpit"
  description="MellyTrade: a trading analytics and monitoring interface concept for signals, risk and system health. Read-only, dry-run; no broker execution."
>
  <ProjectCaseStudyShell current="mellytrade" bare>
    <section class="phero ground-surface" aria-labelledby="mt-title">
      <div class="content-width stack">
        <p class="chip-row">
          <StatusChip variant="concept" label="CONCEPT INTERFACE · SAMPLE VALUES" />
          <span class="badge">Analytics</span>
        </p>
        <h1 id="mt-title" class="phero__title">MellyTrade</h1>
        <p class="phero__tag">
          Data-dense analytics and monitoring dashboard for signals, risk, and system health.
        </p>
        <p class="badge badge--safety" style="align-self:flex-start;">
          STATIC CASE STUDY · READ-ONLY · DRY-RUN · NO BROKER EXECUTION
        </p>
      </div>
      <div class="cinematic-width" style="margin-top:var(--space-32);">
        <ScreenshotFrame
          src="/assets/mellytrade/mellytrade-analytics-monitoring-concept-1672x941.webp"
          alt={alt}
          caption="MellyTrade — concept interface render, dashboard overview."
          crop={overviewCrop}
          srcWidth={1672}
          srcHeight={941}
          scrollable
          scrollWidth={940}
          eager
        />
        <p class="pan-hint">Swipe or use arrow keys to inspect the full interface.</p>
        <p class="concept-note">
          Interface concept. Figures shown are placeholder values; no live data source,
          market connection or production deployment is connected.
        </p>
      </div>
    </section>

    <Chapter id="premise" title="01 · Product premise" ground="canvas" eyebrow="Clarity under density">
      <p class="pchapter__body">
        MellyTrade explores a high-density trading-intelligence interface: analytics,
        signal surfaces, risk visibility, alerting and system health brought into one
        operational dashboard — dense, but never noisy.
      </p>
      <p class="pchapter__body">
        What transfers to client work is the interface engineering: complex dashboards,
        data-heavy monitoring surfaces and status and risk views for operational
        business software. Trading is the subject of the case study, not the offer.
      </p>
    </Chapter>

    <Chapter id="dashboard" title="02 · Main dashboard" ground="surface">
      <p class="pchapter__body">
        One overview screen answers the first questions an operator asks: what is
        happening, what needs attention, and is the system itself healthy.
      </p>
    </Chapter>

    <Chapter id="hierarchy" title="03 · Information hierarchy" ground="canvas">
      <p class="pchapter__body">
        Summary metrics sit on top, the primary chart in the middle, and lists of
        signals and alerts beside it, with the data workflow beneath. Reading order
        follows urgency, and type scale carries the rest.
      </p>
    </Chapter>

    <Chapter id="signals" title="04 · Signal / risk presentation" ground="surface">
      <p class="pchapter__body">
        Signals are shown with direction, strength and a confidence indicator; risk
        exposure is a headline metric, and a threshold breach becomes a ranked alert.
        Each carries a text label, so meaning never depends on colour alone.
      </p>
    </Chapter>

    <Chapter id="alerts" title="05 · Alerting / health presentation" ground="canvas">
      <p class="pchapter__body">
        Alerts are ranked and timestamped, with the reason stated in a sentence — a
        data-quality warning sits in the same list as a risk alert, so a data problem
        is visible before it becomes a signal problem.
      </p>
    </Chapter>

    <Chapter id="workflow" title="06 · Data / system workflow" ground="surface">
      <p class="pchapter__body">
        Four stages, one direction: data comes in, is validated, is analysed, and is
        monitored — with alerting as the visible end of the chain.
      </p>
      <ProcessSpine label="Data and analytics workflow" steps={workflow} />
      <div style="margin-top:var(--space-32);width:100%;">
        <ScreenshotFrame
          src="/assets/mellytrade/mellytrade-analytics-monitoring-concept-1672x941.webp"
          alt={workflowAlt}
          caption="MellyTrade — the data and analytics workflow panel from the same concept render."
          crop={workflowCrop}
          srcWidth={1672}
          srcHeight={941}
          scrollable
          scrollWidth={700}
        />
      </div>
    </Chapter>

    <Chapter id="design" title="07 · Design language" ground="canvas">
      <p class="pchapter__body">
        A dark, quiet canvas so that data — not chrome — carries the colour. The
        screenshot uses its own palette; the portfolio around it stays neutral.
      </p>
    </Chapter>

    <Chapter id="status" title="08 · Project status" ground="surface">
      <p><StatusChip variant="concept" label="CONCEPT INTERFACE · NOT CONNECTED TO MARKETS" /></p>
      <p class="pchapter__body">
        A case-study visual, not an active production system. No trades, profit and
        loss, users, live market connectivity or broker execution are claimed. The
        wider project is read-only and dry-run.
      </p>
    </Chapter>
  </ProjectCaseStudyShell>
</BaseLayout>
