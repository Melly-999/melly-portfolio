---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCaseStudyShell from "../../components/ProjectCaseStudyShell.astro";
import Chapter from "../../components/Chapter.astro";
import StatusChip from "../../components/StatusChip.astro";
import ProcessSpine from "../../components/ProcessSpine.astro";
import KlausOrchestrationDiagram from "../../components/KlausOrchestrationDiagram.astro";

/**
 * /projects/klaus — AI orchestration + coding agent.
 *
 * EVIDENCE: no Klaus repository, document or run record was found in the local
 * planning and workspace files. The role and architecture below are owner-defined,
 * so every capability is classified CONCEPTUAL. Nothing is presented as
 * implemented, validated, shipped, or connected to a live provider or model.
 */
const stages = [
  { label: "Intent" },
  { label: "Context" },
  { label: "Orchestration", key: true },
  { label: "Implementation" },
  { label: "Review" },
  { label: "Validation", key: true },
  { label: "Handoff" },
] as const;

/**
 * A worked trace of ONE hypothetical task through the seven stages. It illustrates
 * how the workflow is designed to move a task; it is not a record of work Klaus
 * performed, so every line is written as design ("is scoped", "is selected"), never
 * as an event that happened.
 */
const traceTask = "Add a source-grounded search feature to an internal operations dashboard.";
const trace = [
  {
    stage: "Intent",
    input: "“Add source-grounded document search.”",
    action: "State what must exist, what must not change, and how “done” will be judged.",
    output: "Scoped task with acceptance criteria.",
  },
  {
    stage: "Context",
    input: "Relevant repository files, project rules and truth boundaries.",
    action: "Select only the slice each role needs.",
    output: "Compact context packet.",
  },
  {
    stage: "Orchestration",
    input: "Scoped task and context packet.",
    action: "Split the work by role and assign each role to its configured agent or model.",
    output: "Architecture, implementation and review lanes.",
  },
  {
    stage: "Implementation",
    input: "Approved technical plan.",
    action: "Make the change in bounded steps, under the same rules the plan was written with.",
    output: "Candidate code change.",
  },
  {
    stage: "Review",
    input: "Candidate diff.",
    action: "A separate lane checks it against the intent and the project rules.",
    output: "Issues and corrections.",
  },
  {
    stage: "Validation",
    input: "Corrected implementation.",
    action: "Check the build, the relevant tests and the rendered result; anything that cannot be verified is reported as unverified.",
    output: "Check, build and test results, plus rendered evidence.",
  },
  {
    stage: "Handoff",
    input: "Verified result.",
    action: "Record what was asked, what changed, what was verified and what remains.",
    output: "Final report and next state.",
  },
] as const;
---

<BaseLayout
  title="Klaus Dev Orchestrator — AI orchestration and coding agent"
  description="Klaus Dev Orchestrator: a concept for a personal AI engineering operator that orchestrates agents and coding work through context, implementation, review and validation."
>
  <ProjectCaseStudyShell current="klaus" bare>
    <section class="phero ground-surface" aria-labelledby="klaus-title">
      <div class="content-width stack">
        <p class="chip-row">
          <StatusChip variant="concept" label="CONCEPT · OWNER-DEFINED ARCHITECTURE" />
          <span class="badge">Orchestration + coding agent</span>
        </p>
        <h1 id="klaus-title" class="phero__title">Klaus Dev Orchestrator</h1>
        <p class="phero__tag">
          AI orchestration and coding agent for coordinating development workflows,
          agent and model handoffs, implementation tasks, and verification.
        </p>
      </div>
    </section>

    <Chapter id="intent" title="01 · Intent" ground="canvas">
      <p class="pchapter__body">
        Work starts from a stated intent, not a prompt pile: what should exist, what
        must not change, and how it will be judged done. Klaus is designed to keep that
        intent as the fixed point every later step is checked against.
      </p>
      <p class="pchapter__body">
        The class of work it stands for: automating technical workflows — task routing,
        context handoff between agents, review and validation — the same thinking I apply
        when scoping automation for a client. It is a concept here, not a delivered system.
      </p>
    </Chapter>

    <Chapter id="context" title="02 · Context" ground="surface">
      <p class="pchapter__body">
        A coding agent is only as good as the context it carries. Klaus is designed to
        hold project context — repository state, rules, prior decisions — and hand the
        relevant slice to each agent, instead of asking every agent to rediscover it.
      </p>
    </Chapter>

    <Chapter id="orchestration" title="03 · Orchestration" ground="canvas" eyebrow="The core of the concept">
      <p class="pchapter__body">
        Klaus sits between intent and execution. It splits work across roles — an
        architect, an implementer, a reviewer — and routes each to whichever agent or
        model is configured for that role.
      </p>
      <KlausOrchestrationDiagram />
    </Chapter>

    <Chapter id="implementation" title="04 · Implementation" ground="surface">
      <p class="pchapter__body">
        The coding lane turns an approved plan into changes, in bounded steps. It is
        meant to work against the same context and rules the plan was written under.
      </p>
    </Chapter>

    <Chapter id="review" title="05 · Review" ground="canvas">
      <p class="pchapter__body">
        Implementation is never its own judge. A separate review lane inspects the
        result against the intent and the project rules before anything moves on.
      </p>
    </Chapter>

    <Chapter id="validation" title="06 · Validation" ground="surface">
      <p class="pchapter__body">
        Validation is a gate, not a summary: checks run, results are read, and a step
        that cannot be verified is reported as unverified rather than assumed to pass.
      </p>
    </Chapter>

    <Chapter id="handoff" title="07 · Handoff" ground="canvas">
      <p class="pchapter__body">
        Each cycle ends with a record: what was asked, what changed, what was
        verified, and what remains — so the next session, or the next agent, starts
        from facts.
      </p>
      <ProcessSpine label="Klaus workflow" steps={stages} />
    </Chapter>

    <Chapter id="job-router" title="08 · Downstream: Job Router Finder" ground="surface" eyebrow="An application built on Klaus">
      <p><StatusChip variant="concept" label="CONCEPT · APPLICATION ON KLAUS" /></p>
      <p class="pchapter__body">
        Job Router Finder is opportunity intelligence built on Klaus Dev
        Orchestrator, not a separate orchestrator of its own: it inherits
        Klaus's operator skills and approval policy to search postings, score
        fit against a profile, and draft an application — then stop for a
        person to send it.
      </p>
      <p class="pchapter__body">
        It is one workflow Klaus can run, the same way the coding, review and
        validation stages above are — not a peer system next to Klaus.
      </p>
    </Chapter>

    <Chapter id="status" title="Current status" ground="surface">
      <p><StatusChip variant="concept" label="CONCEPTUAL · NOT IMPLEMENTED HERE" /></p>
      <p class="pchapter__body">
        Klaus is presented as an owner-defined role and architecture. No public
        repository, verified run, or live provider or model integration is claimed on
        this page.
      </p>

      <div class="wtrace">
        <p class="wtrace__label mono">CONCEPTUAL WORKED TRACE</p>
        <h3 class="wtrace__title">One hypothetical task, seven stages</h3>
        <p class="wtrace__task">
          <span class="wtrace__task-label mono">Example task</span>
          {traceTask}
        </p>
        <p class="pchapter__body wtrace__note">
          This shows how the workflow is designed to move a task. It is a design
          illustration, not a record of work Klaus performed.
        </p>
        <ol class="wtrace__list" aria-label="Conceptual worked trace: seven stages">
          {
            trace.map((s, i) => (
              <li class="wtrace__step">
                <p class="wtrace__stage mono">
                  <span class="wtrace__n">{String(i + 1).padStart(2, "0")}</span>{" "}
                  {s.stage}
                </p>
                <dl class="wtrace__io">
                  <div>
                    <dt class="mono">Input</dt>
                    <dd>{s.input}</dd>
                  </div>
                  <div>
                    <dt class="mono">Action</dt>
                    <dd>{s.action}</dd>
                  </div>
                  <div class="wtrace__out">
                    <dt class="mono">Output</dt>
                    <dd>{s.output}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ol>
      </div>
    </Chapter>
  </ProjectCaseStudyShell>
</BaseLayout>

<style>
  /* Worked trace: editorial rules and type, no cards, no fills. Every state is
     carried by a text label (INPUT / ACTION / OUTPUT), never by colour alone. */
  .wtrace {
    margin-top: var(--space-32);
    max-width: 860px;
  }

  .wtrace__label {
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }

  .wtrace__title {
    margin-top: var(--space-8);
    font-size: var(--text-body-lg);
    font-weight: 600;
    color: var(--color-ink);
  }

  .wtrace__task {
    margin-top: var(--space-12);
    color: var(--color-ink);
  }

  .wtrace__task-label {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .wtrace__note {
    margin-top: var(--space-8);
  }

  .wtrace__list {
    margin: var(--space-24) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .wtrace__step {
    display: grid;
    gap: var(--space-8) var(--space-24);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-line);
  }

  .wtrace__stage {
    margin: 0;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* The gap after the number is a real space (in the markup), so assistive tech reads
     "01 Intent", not "01Intent". */
  .wtrace__n {
    color: var(--color-ink-muted);
  }

  .wtrace__io {
    display: grid;
    gap: var(--space-8);
    margin: 0;
  }

  .wtrace__io > div {
    display: grid;
    gap: var(--space-4) var(--space-16);
  }

  .wtrace__io dt {
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .wtrace__io dd {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .wtrace__out dd {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .wtrace__step {
      grid-template-columns: 180px minmax(0, 1fr);
    }

    .wtrace__io > div {
      grid-template-columns: 64px minmax(0, 1fr);
    }
  }
</style>
