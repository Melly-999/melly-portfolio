---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects, concepts } from "../../data/projects";

const [yuzuki, klaus, mellycore, rag, mellytrade, workspace] = projects;
const [automation] = concepts;
---

<BaseLayout
  title="Projects — Mateusz Ozimkiewicz"
  description="Selected projects by Mateusz Ozimkiewicz: Yuzuki, a local-first AI desktop; Klaus Dev Orchestrator, an AI orchestration and coding agent; MellyCore, a command-center architecture; OpsPilot AI, an operations automation workflow; RAG Assistant, a document intelligence assistant; and MellyTrade, an analytics interface."
>
  <section class="section content-width">
    <h1 style="font-size:var(--text-h1);">Projects</h1>
    <p class="reading-width" style="margin-top:var(--space-8);color:var(--color-ink-secondary);">
      One flagship, then the systems around it — each labelled with how well it is
      proven.
    </p>

    <div style="margin-top:var(--space-32);">
      <ProjectCard
        weight="flagship"
        headingLevel={2}
        title={yuzuki.title}
        subtitle={yuzuki.tagline}
        description={yuzuki.description}
        stack={yuzuki.stack}
        href={yuzuki.href}
        chips={yuzuki.chips}
        image={yuzuki.image}
        imageAlt={yuzuki.imageAlt}
        imageCaption={yuzuki.imageCaption}
        threshold
      />
      <ProjectCard
        weight={klaus.weight}
        headingLevel={2}
        label={klaus.badge}
        title={klaus.title}
        subtitle={klaus.tagline}
        description={klaus.description}
        stack={klaus.stack}
        href={klaus.href}
        chips={klaus.chips}
      />
      <ProjectCard
        weight={mellycore.weight}
        headingLevel={2}
        label={mellycore.badge}
        title={mellycore.title}
        subtitle={mellycore.tagline}
        description={mellycore.description}
        stack={mellycore.stack}
        href={mellycore.href}
        chips={mellycore.chips}
      />
      <ProjectCard
        weight="standard"
        headingLevel={2}
        label="Automation"
        title={automation.title}
        subtitle={automation.tagline}
        description={automation.statement}
        stack="Signal · Analysis · Qualification · Suggested action · Human review"
        href="/#automation"
        chips={[automation.chip]}
      />
      <ProjectCard
        weight={rag.weight}
        headingLevel={2}
        label={rag.badge}
        title={rag.title}
        subtitle={rag.tagline}
        description={rag.description}
        stack={rag.stack}
        href={rag.href}
        chips={rag.chips}
      />

      <h2 class="other-heading mono">Other work</h2>
      <ProjectCard
        weight={mellytrade.weight}
        headingLevel={2}
        label={mellytrade.badge}
        title={mellytrade.title}
        subtitle={mellytrade.tagline}
        description={mellytrade.description}
        stack={mellytrade.stack}
        href={mellytrade.href}
        chips={mellytrade.chips}
      />
      <ProjectCard
        weight={workspace.weight}
        headingLevel={2}
        label={workspace.badge}
        title={workspace.title}
        subtitle={workspace.tagline}
        description={workspace.description}
        stack={workspace.stack}
        href={workspace.href}
        chips={workspace.chips}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .other-heading {
    margin-top: var(--space-32);
    padding-top: var(--space-24);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-muted);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
