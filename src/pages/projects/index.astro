---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects, concepts } from "../../data/projects";

const [flagship, ...rest] = projects;
const [automation] = concepts;
---

<BaseLayout
  title="Projects — Mateusz Ozimkiewicz"
  description="Selected projects by Mateusz Ozimkiewicz: Yuzuki, a local-first AI desktop with a fail-closed private mode; MellyCore, an agent-orchestration architecture; and supporting work."
>
  <section class="section content-width">
    <h1 style="font-size:var(--text-h1);">Projects</h1>
    <p class="reading-width" style="margin-top:var(--space-8);color:var(--color-ink-secondary);">
      One flagship, one architecture, and supporting work — each labelled with how
      well it is proven.
    </p>

    <div style="margin-top:var(--space-32);">
      <ProjectCard
        weight="flagship"
        headingLevel={2}
        title={flagship.title}
        subtitle={flagship.tagline}
        description={flagship.description}
        stack={flagship.stack}
        href={flagship.href}
        chips={flagship.chips}
        image={flagship.image}
        imageAlt={flagship.imageAlt}
        imageCaption={flagship.imageCaption}
        threshold
      />
      {
        rest.map((project) => (
          <ProjectCard
            headingLevel={2}
            label={project.badge}
            title={project.title}
            subtitle={project.tagline}
            description={project.description}
            stack={project.stack}
            href={project.href}
            chips={project.chips}
          />
        ))
      }
      <ProjectCard
        headingLevel={2}
        label="Concept"
        title={automation.title}
        subtitle={automation.tagline}
        description={automation.statement}
        stack="Signal · Analysis · Priority · Suggested action · Human review"
        href="/#automation"
        chips={[automation.chip]}
      />
    </div>
  </section>
</BaseLayout>
