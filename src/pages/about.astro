---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — Mateusz Ozimkiewicz"
  description="About Mateusz Ozimkiewicz, a full-stack developer building safety-first AI tooling."
>
  <section class="section content-width">
    <h1 style="font-size:var(--text-h1);">About</h1>
    <p class="reading-width" style="margin-top:var(--space-16);color:var(--color-text-secondary);">
      Full-Stack Developer working across React, TypeScript, and
      FastAPI, with an AI-assisted workflow built around engineering
      discipline: dry-run defaults, read-only modes, and honest limits. From
      the first note to a shippable product, I keep the work reviewable through
      documented constraints, tests, and clear handoffs.
    </p>
  </section>
</BaseLayout>
